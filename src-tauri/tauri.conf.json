{
  "$schema": "https://raw.githubusercontent.com/nicklasxyz/tauri/tauri-v2/crates/tauri-config-schema/schema.json",
  "productName": "NEXUS 1.0",
  "version": "3.0.0",
  "identifier": "com.nexus1.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:;",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "NEXUS 1.0 — Agentic AI Platform",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agentic AI Platform",
    "longDescription": "Secure, local multi-model AI collaboration platform. Zero data leaves your machine.",
    "copyright": "NEXUS 1.0",
    "licenseFile": "../LICENSE",
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 34
    }
  },
  "plugins": {
    "store": {
      "path": "nexus1-store.json"
    }
  }
}
